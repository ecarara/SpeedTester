{
  "additionalProperties": false,
  "properties": {
    "client_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Client Id",
      "type": "string"
    },
    "access_token": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "title": "Access Token",
      "type": "string"
    },
    "refresh_token": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "title": "Refresh Token",
      "type": "string"
    },
    "expires_at": {
      "minimum": 0,
      "title": "Expires At",
      "type": "integer"
    },
    "refresh_expires_at": {
      "minimum": 0,
      "title": "Refresh Expires At",
      "type": "integer"
    },
    "nonce": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "title": "Nonce",
      "type": "string"
    },
    "possession_key": {
      "maxLength": 43,
      "minLength": 43,
      "title": "Possession Key",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Request Id",
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "access_token",
    "refresh_token",
    "expires_at",
    "refresh_expires_at",
    "nonce",
    "possession_key",
    "request_id"
  ],
  "title": "CredentialBundle",
  "type": "object"
}
