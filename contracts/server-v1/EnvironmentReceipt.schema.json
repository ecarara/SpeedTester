{
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1",
      "default": "1",
      "title": "Protocol Version",
      "type": "string"
    },
    "environment_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Environment Id",
      "type": "string"
    },
    "client_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Client Id",
      "type": "string"
    },
    "digest": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Digest",
      "type": "string"
    },
    "accepted_at": {
      "minimum": 0,
      "title": "Accepted At",
      "type": "integer"
    }
  },
  "required": [
    "environment_id",
    "client_id",
    "digest",
    "accepted_at"
  ],
  "title": "EnvironmentReceipt",
  "type": "object"
}
