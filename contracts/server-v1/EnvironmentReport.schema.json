{
  "$defs": {
    "SystemEnvironment": {
      "additionalProperties": false,
      "properties": {
        "system": {
          "enum": [
            "linux",
            "windows",
            "macos",
            "freebsd",
            "other"
          ],
          "title": "System",
          "type": "string"
        },
        "distribution": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z0-9._-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Distribution"
        },
        "version": {
          "anyOf": [
            {
              "maxLength": 40,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._+-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Version"
        },
        "architecture": {
          "enum": [
            "amd64",
            "arm64",
            "x86",
            "arm",
            "other"
          ],
          "title": "Architecture",
          "type": "string"
        }
      },
      "required": [
        "system",
        "architecture"
      ],
      "title": "SystemEnvironment",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "protocol_version": {
      "const": "1",
      "default": "1",
      "title": "Protocol Version",
      "type": "string"
    },
    "environment_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Environment Id",
      "type": "string"
    },
    "client_id": {
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "title": "Client Id",
      "type": "string"
    },
    "reported_at": {
      "minimum": 0,
      "title": "Reported At",
      "type": "integer"
    },
    "environment": {
      "$ref": "#/$defs/SystemEnvironment"
    }
  },
  "required": [
    "environment_id",
    "client_id",
    "reported_at",
    "environment"
  ],
  "title": "EnvironmentReport",
  "type": "object"
}
