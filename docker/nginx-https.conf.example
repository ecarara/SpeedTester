# Replace host and certificate paths with operator-controlled values.
server {
    listen 80;
    server_name speedtester.example.com;
    return 308 https://speedtester.example.com$request_uri;
}
server {
    listen 443 ssl;
    server_name speedtester.example.com;
    ssl_certificate /etc/nginx/ssl/speedtester/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/speedtester/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 64k;
    client_body_timeout 15s;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host speedtester.example.com;
        # Replace forwarded values; clients cannot choose their limiter identity.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
