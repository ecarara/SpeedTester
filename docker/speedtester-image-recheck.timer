[Unit]
Description=Recheck deployed SpeedTester images with current vulnerability data
[Timer]
OnCalendar=Sun *-*-* 03:10:00
Persistent=true
RandomizedDelaySec=120
Unit=speedtester-image-recheck.service
[Install]
WantedBy=timers.target
