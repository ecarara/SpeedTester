SAMPLE_INTERVAL_SECONDS=1800
SAMPLE_DURATION_SECONDS=30
# Runner principal da coleta agendada. O projeto usa iPerf3 por padrão;
# configure um servidor controlado e alcançável em IPERF3_SERVER abaixo.
SPEEDTEST_RUNNER=iperf3
MEASUREMENTS_PER_QUADRANT=2
SCHEDULER_LATE_TOLERANCE_SECONDS=900
# If the first download is below 50% of the contract, run one immediate retry.
ANOMALY_RETRY_RATIO=0.5
# Optional absolute threshold; leave blank to disable when no contract is set.
ANOMALY_RETRY_MIN_DOWNLOAD_MBPS=
MAX_BYTES=10000000
# Ookla server ID. 29564 is PORTAL TELECOM in Bayeux.
SPEEDTEST_SERVER_IDS=29564
# Official Ookla binary path inside the collector image.
OOKLA_BINARY=speedtest
# Required by the iperf3 runner. Prefer a self-hosted server or a trusted
# nearby endpoint; public servers are best-effort and may be rate-limited.
IPERF3_SERVER=
IPERF3_PORT=5201
IPERF3_DURATION_SECONDS=10
IPERF3_PARALLEL_STREAMS=5
# Total wall-clock budget for one iPerf3 measurement; a timeout is killed and
# retried once as a fresh first attempt.
MEASUREMENT_TIMEOUT_SECONDS=60
TZ=America/Sao_Paulo
API_HOST=0.0.0.0
# Host interface exposed by Docker. Keep localhost unless a firewall/VPN/proxy
# is intentionally providing LAN access.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8000
# When set, protects reset and manual availability-event writes.
API_ADMIN_TOKEN=
API_REQUIRE_ADMIN_TOKEN=true
API_RATE_LIMIT_PER_MINUTE=120

# Operational health and alerting.
COLLECTOR_HEARTBEAT_TIMEOUT_SECONDS=120
ALERT_WEBHOOK_URL=
ALERT_SPEED_THRESHOLD_PCT=80
ALERT_COOLDOWN_SECONDS=21600
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30

# Bandwidth contracted by the operator (in Mbps). Optional; if unset, the
# stored value will be NULL. The operator configures this per device.
BANDWIDTH_CONTRACTED_MBP=

# Whether to fall back to an external IP lookup (ipwho.is) when the
# speed test cannot report the ISP. Requires outbound internet access.
ISP_LOOKUP_ENABLED=true
ISP_LOOKUP_TIMEOUT_SECONDS=5

# Recover abandoned RUNNING slots after this lease expires; renewed every 20s.
SLOT_LEASE_SECONDS=300
# Optional off-host backup (use docker/compose.backup-remote.yaml).
# Configure a trusted SSH destination, an age public recipient and SSH directory.
BACKUP_REMOTE=
BACKUP_AGE_RECIPIENT=
BACKUP_SSH_DIR=
IMAGE_TAG=main
