pkgname=speedtester-agent
pkgver=0.4.53
pkgrel=1
pkgdesc='Agente comunitário SpeedTester (opt-in, compartilhamento com o Server)'
arch=('x86_64')
url='https://github.com/ecarara/SpeedTester'
license=('GPL-3.0-or-later')
depends=('python' 'systemd' 'glibc')
optdepends=('speedtester: ícone do menu e coletor local')
install=speedtester-agent.install
# makepkg must not strip the frozen bundle: every file is covered by
# bundle-manifest.json and the native helper rejects any byte change.
options=('!strip' '!debug')
# The bundle checksum is the one published next to the release asset
# (SpeedTesterClient-<release>-linux-x86_64.tar.gz.sha256). Update it together
# with pkgver whenever the release is rebuilt or re-uploaded.
source=("SpeedTesterClient-${pkgver}-linux-x86_64.tar.gz::https://github.com/ecarara/SpeedTester/releases/download/v${pkgver}/SpeedTesterClient-${pkgver}-linux-x86_64.tar.gz"
        'speedtester-agent.py'
        'speedtester-agent.install')
sha256sums=('af3acb09d46e9e82807774bf43ce71bdce07b909dbd59ddaefafa8a44c74f88a' 'f2c43b18ec19a1845ae214c7a9df1aad9fbedfed983b9f72a801a42ad3d176cf' 'a8e655e33c1273b99b07720711ff5ec8ab8d0e39afbc66e29eafd5808b6d9850')

package() {
  install -dm755 "${pkgdir}/usr/lib/speedtester-agent"
  tar -xzf "${srcdir}/SpeedTesterClient-${pkgver}-linux-x86_64.tar.gz" \
    -C "${pkgdir}/usr/lib/speedtester-agent"
  install -Dm644 "${pkgdir}/usr/lib/speedtester-agent/SpeedTesterClient/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm755 "${srcdir}/speedtester-agent.py" \
    "${pkgdir}/usr/bin/speedtester-agent"
}
