post_install() {
  printf '%s\n' \
    "SpeedTester Agent instalado; este pacote não ativa o compartilhamento." \
    "Para compartilhar medições com o Server: sudo speedtester-agent enable" \
    "Para manter tudo desativado, não execute o comando acima."
}

post_upgrade() {
  if [ -f /var/lib/cararalab-speedtester-client/service.json ] && [ ! -f /var/lib/cararalab-speedtester-client/disabled ]; then
    /usr/bin/speedtester-agent repair || true
  fi
}

pre_remove() {
  /usr/bin/speedtester-agent remove || true
}
