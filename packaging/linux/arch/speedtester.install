post_install() {
  cat <<'EOF'
SpeedTester installed. Configure ~/.config/speedtester/speedtester.env, then
enable the per-user services with:
  systemctl --user daemon-reload
  systemctl --user enable --now speedtester-api.service speedtester-client.service
EOF
}

post_upgrade() {
  systemctl --user daemon-reload >/dev/null 2>&1 || true
}

post_remove() {
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  echo 'SpeedTester removed; user configuration and history were preserved.'
}
