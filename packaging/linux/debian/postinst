set -e
if command -v runuser >/dev/null 2>&1 && [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ] && [ -x /usr/lib/speedtester/configure-user.sh ]; then
    runuser -u "$SUDO_USER" -- env \
        SPEEDTESTER_CONFIRM_EXISTING=1 \
        SPEEDTESTER_ENV_TEMPLATE=/usr/share/speedtester/speedtester.env.example \
        /usr/lib/speedtester/configure-user.sh || true
fi
if command -v systemctl >/dev/null 2>&1 && [ -n "${SUDO_USER:-}" ]; then
    runuser -u "$SUDO_USER" -- systemctl --user daemon-reload >/dev/null 2>&1 || true
    runuser -u "$SUDO_USER" -- systemctl --user try-restart speedtester-api.service speedtester-client.service >/dev/null 2>&1 || true
fi
exit 0
