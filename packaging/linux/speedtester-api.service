[Unit]
Description=SpeedTester local dashboard API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/speedtester/app
EnvironmentFile=-%h/.config/speedtester/speedtester.env
Environment=API_PORT=8000
Environment=PYTHONPATH=%h/.local/share/speedtester/app
ExecStart=%h/.local/share/speedtester/venv/bin/python -m uvicorn api.server:app --host 127.0.0.1 --port ${API_PORT}
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=default.target
