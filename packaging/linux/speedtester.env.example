# SpeedTester per-user configuration.
# One client: empty IPERF3_SERVER selects the nearest catalog destination by
# geographic location. Set a hostname/IP only to override automatic selection.
SPEEDTEST_RUNNER=iperf3
IPERF3_SERVER=
IPERF3_PORT=5201
# Optional confirmed location. Empty values use approximate IP geolocation.
SPEEDTESTER_COUNTRY_CODE=
SPEEDTESTER_CITY=
IPERF3_DURATION_SECONDS=10
IPERF3_PARALLEL_STREAMS=5
MEASUREMENT_TIMEOUT_SECONDS=60
MEASUREMENTS_PER_QUADRANT=2
# Mbps, confirmed during installation AND upgrades. Legacy download key retained.
BANDWIDTH_CONTRACTED_MBP=
BANDWIDTH_CONTRACTED_UPLOAD_MBPS=
ANOMALY_RETRY_RATIO=0.5
TZ=America/Sao_Paulo
API_PORT=8000
API_REQUIRE_LOGIN=false
API_REQUIRE_ADMIN_TOKEN=true
