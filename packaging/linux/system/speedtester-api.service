[Unit]
Description=SpeedTester local dashboard API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/usr/lib/speedtester
EnvironmentFile=-%h/.config/speedtester/speedtester.env
Environment=DB_PATH=%h/.local/share/speedtester/data/speedtester.db
Environment=SPEEDTESTER_LOCAL_MODE=true
Environment=API_PORT=8000
ExecStart=/usr/lib/speedtester/runtime/SpeedTesterAPI/SpeedTesterAPI
Restart=on-failure
RestartSec=5s
UMask=0077

[Install]
WantedBy=default.target
