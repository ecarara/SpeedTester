[Unit]
Description=SpeedTester broadband measurement client
Wants=network-online.target
After=network-online.target speedtester-api.service
Requires=speedtester-api.service

[Service]
Type=simple
WorkingDirectory=/usr/lib/speedtester
EnvironmentFile=-%h/.config/speedtester/speedtester.env
Environment=DB_PATH=%h/.local/share/speedtester/data/speedtester.db
ExecStart=/usr/lib/speedtester/runtime/SpeedTesterClient/SpeedTesterClient
Restart=on-failure
RestartSec=10s
UMask=0077

[Install]
WantedBy=default.target
